# Développement local et service Web Render. Ne versionnez jamais le fichier .env.
# Sur Render, renseignez ces valeurs dans Environment, pas dans un fichier.
DATABASE_URL=postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:5432/NOM_DE_LA_BASE
SESSION_SECRET=GENEREZ_UN_SECRET_ALEATOIRE_D_AU_MOINS_32_CARACTERES
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CHOISISSEZ_UN_MOT_DE_PASSE_FORT_D_AU_MOINS_12_CARACTERES

# Identifiant(s) autorisé(s) à ouvrir la Console Créateur, séparés par des virgules.
# À renseigner également dans les variables d’environnement Render.
CREATOR_USERNAMES=admin

# Récupération d’urgence du mot de passe Créateur (à retirer immédiatement après connexion).
# L’identifiant doit déjà figurer dans CREATOR_USERNAMES.
CREATOR_PASSWORD_RECOVERY_USERNAME=identifiant-createur
CREATOR_PASSWORD_RECOVERY_PASSWORD=CHOISISSEZ_UN_NOUVEAU_MOT_DE_PASSE_FORT_D_AU_MOINS_12_CARACTERES
CREATOR_PASSWORD_RECOVERY_CONFIRM=RESET_CREATOR_PASSWORD

# Secours exceptionnel en cas de perte du téléphone Google Authenticator.
# L’identifiant doit déjà figurer dans CREATOR_USERNAMES. Retirez ces variables juste après redémarrage.
# CREATOR_TOTP_RECOVERY_USERNAME=identifiant-createur
# CREATOR_TOTP_RECOVERY_CONFIRM=RESET_CREATOR_TOTP

# false recommandé : seuls les administrateurs provisionnent les comptes.
ALLOW_PUBLIC_REGISTRATION=false
NODE_ENV=development

# Envoi direct des devis et factures PDF. À renseigner dans Render > Environment.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_SECURE=false
BREVO_SMTP_USER=votre-identifiant-smtp
BREVO_SMTP_PASSWORD=votre-mot-de-passe-ou-cle-smtp
BREVO_SMTP_FROM=Depann'Home Pro <support@depannhomepro.com>

# Contrôle quotidien des échéances d’abonnement. Les factures sont créées et envoyées une seule fois
# après configuration, dans la Console Créateur, des coordonnées légales et bancaires de la plateforme.
SUBSCRIPTION_INVOICING_HOUR=0
SUBSCRIPTION_INVOICING_MINUTE=10

# Adresse qui reçoit les demandes envoyées depuis l’espace technicien.
SUPPORT_EMAIL=support@depannhomepro.com